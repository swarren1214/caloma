        rotationModeRaw   STRING QUERYABLE SEARCHABLE SORTABLE,
        rotationPeriodRaw STRING QUERYABLE SEARCHABLE SORTABLE,
        rotationSlot      INT64 QUERYABLE SORTABLE,
        rotationWeekday   INT64 QUERYABLE SORTABLE,
