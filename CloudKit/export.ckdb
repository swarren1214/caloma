DEFINE SCHEMA

    RECORD TYPE Account (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        balanceCents    ENCRYPTED INT64,
        balanceDate     ENCRYPTED TIMESTAMP,
        colorHex        ENCRYPTED INT64,
        createdAt       ENCRYPTED TIMESTAMP,
        includeInBudget ENCRYPTED INT64,
        institution     ENCRYPTED STRING,
        kindRaw         ENCRYPTED STRING,
        mask            ENCRYPTED STRING,
        name            ENCRYPTED STRING,
        plaidAccountID  ENCRYPTED STRING,
        plaidItemID     ENCRYPTED STRING,
        sortOrder       ENCRYPTED INT64,
        sourceRaw       ENCRYPTED STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Bill (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        amountCents     ENCRYPTED INT64,
        categoryID      ENCRYPTED STRING,
        colorRaw        ENCRYPTED STRING,
        createdAt       ENCRYPTED TIMESTAMP,
        dueDay          ENCRYPTED INT64,
        frequencyRaw    ENCRYPTED STRING,
        interval        ENCRYPTED INT64,
        isActive        ENCRYPTED INT64,
        isAutopay       ENCRYPTED INT64,
        isSubscription  ENCRYPTED INT64,
        isVariable      ENCRYPTED INT64,
        name            ENCRYPTED STRING,
        note            ENCRYPTED STRING,
        payURL          ENCRYPTED STRING,
        startDate       ENCRYPTED TIMESTAMP,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE BudgetCategory (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        colorRaw        ENCRYPTED STRING,
        createdAt       ENCRYPTED TIMESTAMP,
        isArchived      ENCRYPTED INT64,
        limitCents      ENCRYPTED INT64,
        name            ENCRYPTED STRING,
        parentID        ENCRYPTED STRING,
        repeatsMonthly  ENCRYPTED INT64,
        sortOrder       ENCRYPTED INT64,
        startMonth      ENCRYPTED TIMESTAMP,
        symbol          ENCRYPTED STRING,
        taxTagRaw       ENCRYPTED STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE BudgetMember (
        "___createTime" TIMESTAMP,
