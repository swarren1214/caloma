    RECORD TYPE Chore (
        "___createTime"   TIMESTAMP,
        "___createdBy"    REFERENCE,
        "___etag"         STRING,
        "___modTime"      TIMESTAMP,
        "___modifiedBy"   REFERENCE,
        "___recordID"     REFERENCE,
        assigneeIDsRaw    STRING QUERYABLE SEARCHABLE SORTABLE,
        createdAt         TIMESTAMP QUERYABLE SORTABLE,
        dueMinutes        INT64 QUERYABLE SORTABLE,
        isArchived        INT64 QUERYABLE SORTABLE,
        points            INT64 QUERYABLE SORTABLE,
        priorityRaw       INT64 QUERYABLE SORTABLE,
        repeatRaw         STRING QUERYABLE SEARCHABLE SORTABLE,
        requiresApproval  INT64 QUERYABLE SORTABLE,
        requiresPhoto     INT64 QUERYABLE SORTABLE,
        roomID            STRING QUERYABLE SEARCHABLE SORTABLE,
        rotates           INT64 QUERYABLE SORTABLE,
