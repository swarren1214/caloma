<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.stephenwarren.caloma</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>caloma</string>
			</array>
		</dict>
	</array>
	<key>CKSharingSupported</key>
	<true/>
	<key>NSHomeKitUsageDescription</key>
	<string>Caloma brings in your home's rooms for chores, controls your lights, locks and climate, and shows your doorbell camera on the Family Board.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Talk to the family on the intercom, and on the Family Board, speak to whoever is at the door through the doorbell.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Caloma finds the family's Family Boards and phones on your home Wi-Fi so you can call them on the intercom.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_caloma-icom._tcp</string>
	</array>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>bigtable</string>
		<string>suffice</string>
		<string>sated</string>
		<string>hearken</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
		<string>audio</string>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>Hearth/splash-caloma</string>
	</dict>
</dict>
</plist>
